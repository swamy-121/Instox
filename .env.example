# Copy to .env.local. Leave secrets empty.

# Local Postgres from docker compose.
DATABASE_URL=postgres://instox:instox@localhost:5432/instox

# Signs session cookies and hashes phone codes. Use 16 or more random characters.
SESSION_SECRET=

# Phone codes. Leave the key empty to write codes to the server log.
# A super admin can save APITXT_AUTHKEY on Integrations instead. It is stored encrypted.
# Set SMS_PROVIDER=dev to force the log even when a key exists.
# Sends go to APITxT without a DLT template.
APITXT_AUTHKEY=
# SMS_PROVIDER=

# Shows the one-tap demo accounts on the sign-in page. Never set this in production.
NEXT_PUBLIC_DEMO_LOGIN=true

# Encrypts integration secrets saved from the admin Integrations page.
# Any random string of 16 or more characters. It never goes in the browser.
# Leave it empty and the page can show environment fallbacks but cannot store new secrets.
INTEGRATIONS_ENC_KEY=

# Payments stay in test mode. Leave keys empty. Remote checkout is not enabled.
# A super admin can save these on Integrations. Environment values are the fallback.
PAYMENTS_PROVIDER=stub
PAYMENTS_MODE=test
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
CASHFREE_CLIENT_ID=
CASHFREE_CLIENT_SECRET=
CASHFREE_WEBHOOK_SECRET=

# Optional Firebase Cloud Messaging. The app boots without these.
# Copy the Web Push certificate from Firebase console > Project settings > Cloud Messaging.
# A super admin can save this on Integrations instead.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_VAPID_KEY=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
# Optional. token addresses each stored device. topic sends one message to instox-tips or instox-marketing.
# FCM_SEND_MODE=token

# Market feed. Leave unset for the mock provider used by tests and CI.
# aliceblue streams Nifty 50, Bank Nifty, and Sensex after the admin connects.
# dev uses public chart quotes for those three indices and is refused when NODE_ENV=production.
# A super admin can save the provider, app code, and API secret on Integrations.
MARKET_DATA_PROVIDER=
ALICEBLUE_APP_CODE=
ALICEBLUE_API_SECRET=
# Leave false. A daily Alice Blue login is your own broker session, not a redistribution licence.
MARKET_DATA_LICENSED=false
