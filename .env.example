# Copy to .env.local. Leave secrets empty. Local dev uses the Firebase emulator.

NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=demo-instox
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_USE_FIREBASE_EMULATOR=true

FIREBASE_PROJECT_ID=demo-instox
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
FIRESTORE_EMULATOR_HOST=127.0.0.1:8080

# Production only. Do not commit real values.
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Payments stay in test mode. Leave keys empty. Remote checkout is not enabled.
PAYMENTS_PROVIDER=stub
PAYMENTS_MODE=test
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
CASHFREE_CLIENT_ID=
CASHFREE_CLIENT_SECRET=
CASHFREE_WEBHOOK_SECRET=

# Web Push. Leave empty until a real VAPID key pair exists. Do not invent one here.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@example.com
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# Sample market data only. Do not set this true without a licence decision.
MARKET_DATA_LICENSED=false
